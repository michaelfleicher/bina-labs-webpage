# Web3Forms - https://web3forms.com
# Sign up, get your access key, copy this file to `.env.local`, paste the key.
# Without this, the contact form and apply modal show a graceful fallback message.
VITE_WEB3FORMS_KEY=your-access-key-here

# Google Analytics 4 - https://analytics.google.com
# Create a Web data stream and paste the Measurement ID below (format: G-XXXXXXXXXX).
# When unset, no GA script is loaded and tracking is fully disabled.
VITE_GA_ID=G-XXXXXXXXXX
