---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutBody from '../components/react/AboutBody.jsx';
import PersonSchema from '../components/schema/PersonSchema.astro';
import RonenPersonSchema from '../components/schema/RonenPersonSchema.astro';
import OrPersonSchema from '../components/schema/OrPersonSchema.astro';
import FAQSchema from '../components/schema/FAQSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { ABOUT_FAQS } from '../data/faqs.js';

const title = 'About - Bina Labs · Michael Fleicher, Ronen Chen & Or Zilberberg';
const description =
  'Bina Labs is led by senior operators in AI engineering, computer vision, automation and innovation strategy. Senior-by-default consulting and development.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about' },
];
---
<BaseLayout title={title} description={description} canonical="/about">
  <PersonSchema slot="head" fullBio />
  <RonenPersonSchema slot="head" fullBio />
  <OrPersonSchema slot="head" fullBio />
  <FAQSchema slot="head" faqs={ABOUT_FAQS} />
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <AboutBody client:load faqs={ABOUT_FAQS} />
</BaseLayout>
