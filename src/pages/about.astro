---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutBody from '../components/react/AboutBody.jsx';
import PersonSchema from '../components/schema/PersonSchema.astro';
import FAQSchema from '../components/schema/FAQSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { ABOUT_FAQS } from '../data/faqs.js';

const title = 'About - Bina Labs · Michael Fleicher, Principal';
const description =
  'Bina Labs is led by Michael Fleicher - engineer, data scientist, two-time CTO. A senior-by-default AI consulting and development studio. Tel Aviv, Berlin.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about' },
];
---
<BaseLayout title={title} description={description} canonical="/about">
  <PersonSchema slot="head" fullBio />
  <FAQSchema slot="head" faqs={ABOUT_FAQS} />
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <AboutBody client:load faqs={ABOUT_FAQS} />
</BaseLayout>
