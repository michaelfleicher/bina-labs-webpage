---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkBody from '../../components/react/WorkBody.jsx';
import ItemListSchema from '../../components/schema/ItemListSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import { CASE_STUDIES } from '../../data/caseStudies.js';

const title = 'Work - Bina Labs · Selected Case Studies';
const description =
  'Things we shipped. 17 selected case studies across vision, agents, data, and strategy: Match Cuts, Auto-QTO, Lloyd Score, Caseworker, and more.';

const items = Object.values(CASE_STUDIES).map((cs) => ({
  slug: cs.slug,
  client: cs.client,
  tagline: cs.tagline,
}));

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Work', url: '/work' },
];
---
<BaseLayout title={title} description={description} canonical="/work">
  <ItemListSchema slot="head" items={items} />
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <WorkBody client:load />
</BaseLayout>
