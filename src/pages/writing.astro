---
import BaseLayout from '../layouts/BaseLayout.astro';
import WritingBody from '../components/react/WritingBody.jsx';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';

const title = 'Writing - Bina Labs';
const description =
  'Notes from production - written by the people who shipped the thing. Eval-first AI engineering, on-prem inference economics, honest deprecation, long-context retrieval. Coming soon.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Writing', url: '/writing' },
];
---
<BaseLayout title={title} description={description} canonical="/writing">
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <WritingBody client:load />
</BaseLayout>
