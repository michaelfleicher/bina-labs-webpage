---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesBody from '../components/react/ServicesBody.jsx';
import ServiceSchema from '../components/schema/ServiceSchema.astro';
import FAQSchema from '../components/schema/FAQSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { SERVICES_FAQS } from '../data/faqs.js';

const title = 'Services - Bina Labs';
const description =
  'Four ways to engage Bina Labs: AI Strategy, AI / Software Engineering, Lectures & Workshops, and applied Research. Senior operators, fixed-scope sprints, embedded squads, fractional CTO.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
];
---
<BaseLayout title={title} description={description} canonical="/services">
  <ServiceSchema slot="head" />
  <FAQSchema slot="head" faqs={SERVICES_FAQS} />
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <ServicesBody client:load faqs={SERVICES_FAQS} />
</BaseLayout>
