---
import { orgSocialLinks } from '../../data/social.js';

const orgSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Bina Labs',
  url: 'https://bina-labs.com/',
  logo: 'https://bina-labs.com/favicon.svg',
  description:
    'A consultancy of engineers, researchers, and strategists that builds AI systems which earn their seat at the production table.',
  email: 'intelligence@bina-labs.com',
  areaServed: ['Tel Aviv', 'Berlin', 'Worldwide'],
  member: [
    {
      '@type': 'Person',
      name: 'Michael Fleicher',
      jobTitle: 'Principal',
      description:
        'Engineer, data scientist, two-time CTO. Building agentic systems and automations since 2017.',
    },
    {
      '@type': 'Person',
      name: 'Ronen Chen',
      jobTitle: 'Principal',
      description:
        'AI and deep-learning expert, innovation strategist, and funding advisor with 20+ years bridging advanced technology and commercial success.',
    },
  ],
};

// Only emit `sameAs` when we have at least one verified external profile -
// an empty array signals "we have no presence" to crawlers, which is worse
// than omitting the field entirely. Add new URLs via src/data/social.js.
if (orgSocialLinks.length > 0) {
  orgSchema.sameAs = orgSocialLinks;
}
---
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
